<hc:SimplePanel x:Class="CourseRush.Controls.LoginRequestDialogBase"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CourseRush.Controls"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:ui="clr-namespace:CourseRush"
             xmlns:util="clr-namespace:CourseRush.Util"
             xmlns:vm="clr-namespace:CourseRush.Models"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:LoginRequestDialogViewModelBase}"
             d:DesignHeight="400" d:DesignWidth="400">
    <hc:SimplePanel>
        <Border Background="{DynamicResource RegionBrush}" CornerRadius="10" Effect="{StaticResource EffectShadow4}"
                Margin="16" Visibility="Collapsed" />
        <Border Style="{StaticResource BorderClip}" Margin="16">
            <Grid Name="ContentGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.RowSpan="2" Background="{DynamicResource RegionBrush}" CornerRadius="10"
                        Effect="{StaticResource EffectShadow4}" />
                <Border Height="Auto" Grid.Row="0" CornerRadius="10,10,0,0" Background="{DynamicResource TitleBrush}"
                        Style="{StaticResource BorderClip}">
                    <hc:SimplePanel>
                        <TextBlock Style="{StaticResource TextBlockDefault}" Text="{Binding Path=Title}" Name="TitleLabel"/>
                    </hc:SimplePanel>
                </Border>
                <Border Grid.Row="1" BorderThickness="1,0,1,1" CornerRadius="0,0,5,5" BorderBrush="{StaticResource BorderBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <hc:UniformSpacingPanel HorizontalAlignment="Stretch" Orientation="Vertical">
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Style="{StaticResource TextBlockDefault}" TextAlignment="Center" HorizontalAlignment="Stretch" FontSize="14"></TextBlock>
                            <Grid Name="ContentPanel" VerticalAlignment="Center" Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <!-- Intended Column Offset! Added by -->
                                <!-- ReSharper disable once Xaml.IndexOutOfGridDefinition -->
                                <Button Grid.Column="1" HorizontalAlignment="Center" MinWidth="100" Content="{Binding PerformAction.Name,Converter={x:Static util:TranslatableTextToStringConverter.Instance},FallbackValue={x:Static system:String.Empty}}" Click="ButtonBase_OnClick"></Button>
                            </Grid>
                        </hc:UniformSpacingPanel>
                        <hc:UniformSpacingPanel Grid.Row="1" Orientation="Horizontal"
                                                FlowDirection="RightToLeft" Margin="0,0,10,0" Spacing="20">
                            <Button Style="{StaticResource ButtonPrimary}" Name="OkButton" Click="OkButton_OnClick" FontSize="15" 
                                    Content="{x:Static ui:Language.ui_button_login}" Margin="0,10,0,10" Padding="10,0,10,0" />
                            <Button Name="CancelButton" Click="CancelButton_OnClick" FontSize="15" 
                                    Content="{x:Static ui:Language.ui_button_cancel}" Padding="10,0,10,0" />
                        </hc:UniformSpacingPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </hc:SimplePanel>
</hc:SimplePanel>
